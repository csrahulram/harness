{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "init": "node src/setup/main.ts",
    "dev": "node --watch --watch-path=src src/main.ts",
    "start": "node src/main.ts",
    "chat": "node --watch --watch-path=src src/chat/main.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coder": "node src/coder/main.ts",
    "undo": "git revert --no-edit HEAD"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
